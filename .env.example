# Copy this file to .env and fill in your values. Never commit .env to source control.

# Shared ORC credentials (same on all three servers)
ORC_ADMIN_USER=admin
ORC_ADMIN_PASS=
ORC_NON_ADMIN_USER=manager
ORC_NON_ADMIN_PASS=

# Windows Administrator account for WinRM server metrics (same password on all three)
ORC_SERVER_USER=Administrator
ORC_SERVER_PASS=

# Vision RTSPS device credentials (shared across all Vision units in the QA lab)
ORC_VISION_USER=arthrex
ORC_VISION_PASS=

# Physical camera credentials (per-device)
ORC_CAM_SONY1_PASS=   # Sony SRG-X120
ORC_CAM_SONY2_PASS=   # Sony SRG-300SE
ORC_CAM_SONY3_PASS=   # Sony SRG-A12
ORC_CAM_AXIS1_PASS=   # Axis M3085-V

# Debug tool: which server to introspect GraphQL schema against (default: qa155)
ORC_INTROSPECT_SERVER=qa155

# Network degradation scenario — IP of the ORC server Clumsy should filter traffic for
# (typically the same host as ORC_QA155_HOST, expressed as a raw IP)
ORC_CLUMSY_SERVER_IP=

# Per-server URLs and IPs (defaults are baked into environments.py; only override if different)
# orc-qa-155  |  8 core / 16 GB
ORC_QA155_URL=
ORC_QA155_HOST=

# orc-qa-160  |  4 core / 8 GB
ORC_QA160_URL=
ORC_QA160_HOST=

# orc-qa-162  |  16 core / 32 GB
ORC_QA162_URL=
ORC_QA162_HOST=

# orc-qa-173  |  32 core / 16 GB
ORC_QA173_URL=
ORC_QA173_HOST=
